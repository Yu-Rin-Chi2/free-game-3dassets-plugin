{
  "name": "freegame3d",
  "version": "1.0.0",
  "description": "Search and download CC0 3D models, PBR materials, decals, MatCaps and skyboxes from Free Game 3D Assets — built for AI agents and humans alike.",
  "type": "module",
  "bin": {
    "freegame3d": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
