    "assets",
    "cc0",
    "gamedev",
    "cli",
    "ai-agent"
  ],
  "homepage": "https://3d.freegameui.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yu-Rin-Chi2/free-game-3dassets-plugin.git",
